# Copy to `.env` and fill in from your Supabase project
# (Dashboard -> Project Settings -> API).
#
# .env is gitignored. Never commit real keys.

NODE_ENV=development
PORT=3000

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# "anon / public" key — safe to expose, used for user-credential flows.
SUPABASE_ANON_KEY=

# "service_role" key — BYPASSES ROW LEVEL SECURITY.
# Server-side only. Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:4200

# Leave blank in development so the cookie binds to the request host.
COOKIE_DOMAIN=
