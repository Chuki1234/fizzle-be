# Copy to `.env` and fill in from your Supabase project
# (Dashboard -> Project Settings -> API).
#
# .env is gitignored. Never commit real keys.

NODE_ENV=development
PORT=3000

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://doolifuykhesjcwltwll.supabase.co

# "anon / public" key — safe to expose, used for user-credential flows.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvb2xpZnV5a2hlc2pjd2x0d2xsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ4MjE3NDUsImV4cCI6MjEwMDM5Nzc0NX0.LmG3IkCVRJInbtPSWCmKLq61A965FlyH7TwGS_XIjMA

# "service_role" key — BYPASSES ROW LEVEL SECURITY.
# Server-side only. Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRvb2xpZnV5a2hlc2pjd2x0d2xsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NDgyMTc0NSwiZXhwIjoyMTAwMzk3NzQ1fQ._XNU5yLwbTcfIuG6TS4ciC5-Wh8ObPwbynNutnxn6HM

# Comma-separated browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:4200

# Leave blank in development so the cookie binds to the request host.
COOKIE_DOMAIN=